# Admin-brukernavn (Fernande)
ADMIN_USERNAME=fernande

# Admin-passord - MÅ settes til noe hemmelig
ADMIN_PASSWORD=changeme

# Hemmelig nøkkel for signering av innloggingsøkter - MÅ settes til en lang, tilfeldig streng
SESSION_SECRET=changeme-to-a-long-random-string

# Valgfritt
PORT=3000

# BLOB_READ_WRITE_TOKEN settes automatisk av Vercel når en Blob-store er
# koblet til prosjektet - trenger ikke settes manuelt her. Uten den bruker
# appen en lokal JSON-fil (DATA_DIR) for lagring, som i Docker.
